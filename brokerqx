    if (pr) pr.style.display = mostrarParar ? "" : "none";
    var tp = raiz.querySelector(".topo");
    if (tp) tp.classList.toggle("apertado", !!mostrarParar);
    // rodando, quem manda no texto é o cronômetro (função correr)
    if (!e.robo_ligado_na_corretora && !jaAvisouDesligado) {
      jaAvisouDesligado = true;
      avisar("The robot is switched off at this broker.");
    }
    if (e.pode_conta_real === false) $("cReal").disabled = true;
    try { $("uniVal").textContent = (e.moeda === "USD") ? "$" : "R$"; } catch (er) {}
    if (metaEmDinheiro && !metaGuardada.val) {
      var sld0 = conta === "real" ? e.saldo_real : e.saldo_demo;
      if (sld0 > 0) { metaGuardada.val = String(Math.round(sld0 * 0.2 * 100) / 100);
        if (!$("meta").value) $("meta").value = metaGuardada.val; }
    }
    if (!rodando) {
      analisar(false);
      corDoEstado("#565E68");
      girarAgulha(ARCO_INI); porCurso(0);
      $("gPct").textContent = "";
      $("gCap").textContent = "PARADO";
      revezarBicho();
      return;
    }
    var moeda = e.moeda || "BRL";
    var pl = $("placar"); pl.textContent = "";
    [["g", e.ganhos || 0], ["x", "\u00d7"], ["p", e.perdas || 0]].forEach(function(par){
      var el = document.createElement("span");
      el.className = par[0]; el.textContent = par[1];
      pl.appendChild(el);
    });
    $("lucro").textContent = (e.lucro >= 0 ? "+" : "") + dinheiro(e.lucro, moeda);
    $("lucro").className = "num " + (e.lucro > 0 ? "verde" : (e.lucro < 0 ? "rubro" : ""));
    $("metaTxt").textContent = dinheiro(e.lucro, moeda) + " / " + dinheiro(e.meta_valor, moeda);
    $("barraMeta").style.width = Math.max(0, Math.min(100, Number(e.progresso_pct) || 0)) + "%";
    // o mostrador: com operação aberta ele PARA no lado e no valor; sem, volta a analisar
    var ops = e.operacoes || [], viva = null;
    for (var i = 0; i < ops.length; i++) { if (ops[i].estado === "aberta") { viva = ops[i]; break; } }
    if (viva) {
      if (!leituraFixa || leituraFixa !== viva.aberta_em) {
        leituraFixa = viva.aberta_em;
        fixarLeitura(viva.direcao, 62 + Math.round(Math.random() * 26));
      }
    } else {
      leituraFixa = 0;
      $("gPct").textContent = "";
      $("gCap").textContent = "ANALISANDO";
      analisar(true);
    }
  }
  var base = null, opAtual = "", opDesde = 0;
  var PREPARANDO = { procurando_grafico: "finding a chart…", motor_indisponivel: "connecting…" };
  function marcar(e){
    var ops = e.operacoes || [], viva = null;
    for (var i = 0; i < ops.length; i++) { if (ops[i].estado === "aberta") { viva = ops[i]; break; } }
    var marcaOp = viva ? String(viva.aberta_em) : "";
    if (marcaOp && marcaOp !== opAtual) { opAtual = marcaOp; opDesde = Date.now(); }
    if (!marcaOp) { opAtual = ""; opDesde = 0; }
    base = { t: Date.now(), prox: e.proxima_em_s, sessao: e.sessao_termina_em_s,
             espera: e.espera_em_s, aberta: e.tem_aberta, expira: e.expiracao_s,
             preparando: PREPARANDO[e.aviso] || "" };
  }
  function correr(){
    if (base && ultimo && ultimo.ligado) {
      var d = (Date.now() - base.t) / 1000;
      if (base.espera > 0) { $("prox").textContent = "break " + relogio(base.espera - d); }
      else if (base.aberta) { $("prox").textContent = "trade in progress"; }
      else if (base.preparando) { $("prox").textContent = base.preparando; }
      else { $("prox").textContent = relogio(base.prox - d); }
      // o relógio da sessão: só o número, em branco, no canto do cabeçalho
      $("btTexto").textContent = relogio(base.sessao - d);
      var a = $("and");
      if (base.aberta && base.expira > 0 && opDesde > 0) {
        var corrido = (Date.now() - opDesde) / 1000;
        var k = Math.max(0, Math.min(1, corrido / base.expira));
        a.style.width = (k * 100) + "%"; a.style.background = "#E9A825";
      } else { a.style.width = "0"; }
    }
    requestAnimationFrame(correr);
  }
  requestAnimationFrame(correr);
  function lerOnline(){
    pedir("/api/fx/online").then(function(j){
      if (!j || !j.ok) return;
      var el = $("fxOnlineN");
      if (el) el.textContent = j.texto || ("+" + Math.floor(Number(j.online) / 1000) + "k");
      setTimeout(lerOnline, (Number(j.falta_s) || 30) * 1000 + 250);
    }).catch(function(){ setTimeout(lerOnline, 30000); });
  }
  lerOnline();
  function atualizar(){
    if (ocupado) return; ocupado = true;
    pedir("/api/fx/estado").then(function(j){
      if (j && j.ok && j.estado) { desenhar(j.estado); marcar(j.estado);
        if (j.estado.ligado) { try { seguirOperacao(j.estado); } catch (e) {} } }
    }).catch(function(){}).then(function(){ ocupado = false; });
  }
  atualizar();
  var ritmo = setInterval(function(){ if (!document.hidden) atualizar(); }, 2000);
  document.addEventListener("visibilitychange", function(){ if (!document.hidden) atualizar(); });
  var DEMO = /demo|treinamento|training|pr[aá]ctica|practice/i;
  var REAL = /real|normal|live/i;
  function contaDoTopo(){
    var b = document.querySelector('[data-testid="BalanceControl"]');
    if (!b) return "";
    var t = b.textContent || "";
    if (DEMO.test(t)) return "demo";
    if (REAL.test(t)) return "real";
    return "";
  }
  function fecharGavetaDeContas(){
    var x = document.querySelector('[data-testid="header-closeButton"]');
    if (x && x.offsetParent !== null) { x.click(); return; }
    document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
  }
  var trocandoConta = false;
  function acertarContaDoTopo(qual){
    if (trocandoConta) return;
    var atual = contaDoTopo();
    if (!atual || atual === qual) return;
    var b = document.querySelector('[data-testid="BalanceControl"]');
    if (!b) return;
    trocandoConta = true;
    b.click();
    var voltas = 0;
    var escolher = function(){
      voltas++;
      var todas = Array.prototype.slice.call(
        document.querySelectorAll('[data-testid^="balanceSelector-row-"]'));
      var linhas = todas.filter(function(e){
        return /balanceSelector-row-\d+$/.test(e.getAttribute("data-testid") || "");
      });
      for (var i = 0; i < linhas.length; i++) {
        var txt = linhas[i].textContent || "";
        var ehDemo = DEMO.test(txt);
        var ehReal = !ehDemo && REAL.test(txt);
        if ((qual === "demo" && ehDemo) || (qual === "real" && ehReal)) {
          linhas[i].click();
          setTimeout(function(){ fecharGavetaDeContas(); trocandoConta = false; }, 900);
          return;
        }
      }
      if (voltas < 10) return setTimeout(escolher, 350);
      fecharGavetaDeContas();
      trocandoConta = false;
    };
    setTimeout(escolher, 500);
    // rede de segurança: a gaveta nunca pode ficar aberta na cara do cliente
    setTimeout(function(){ if (trocandoConta) { fecharGavetaDeContas(); trocandoConta = false; } }, 9000);
  }
  function limpo(t){ return String(t || "").toUpperCase().replace(/[^A-Z0-9]/g, ""); }
  function termosDeBusca(ticker){
    var t = limpo(ticker);
    if (t.length > 3 && t.slice(-3) === "OTC") t = t.slice(0, -3);
    var lista = [t];
    // par cripto: "LUNAUSD" não acha, "LUNA" acha
    if (t.length > 4 && t.slice(-3) === "USD") lista.push(t.slice(0, -3));
    if (t.length > 4) lista.push(t.slice(0, 4));
    var vistos = {}, saida = [];
    lista.forEach(function(x){ if (x && !vistos[x]) { vistos[x] = 1; saida.push(x); } });
    return saida;
  }
  var ultimoAtivo = 0, ocupadoTrocando = false, minhasAbas = [], ultimaTentativa = {};
  var TIPO = "blitz";   // é o que o robô opera; o mesmo par em Binárias é outro gráfico
  function abaDoAtivo(id){
    return document.querySelector('[data-testid="AssetTab-' + id + '-' + TIPO + '"]');
  }
  function selecionada(el){ return !!el && /_selected_/.test(el.className); }
  var cortina = null;
  function esconderLista(sim){
    if (sim) {
      if (cortina) return;
      cortina = document.createElement("style");
      cortina.textContent = '[data-testid="FlowLayoutV2-AssetSelector"]{opacity:0 !important;pointer-events:none !important}';
      (document.head || document.documentElement).appendChild(cortina);
    } else if (cortina) { cortina.remove(); cortina = null; }
  }
  function fecharLista(){
    var x = document.querySelector('[data-testid="header-closeButton"]');
    if (x) x.click();
  }
  function guardarMinha(id){
    if (minhasAbas.indexOf(id) < 0) minhasAbas.push(id);
    while (minhasAbas.length > 2) {
      var velho = minhasAbas.shift();
      if (velho === id) continue;
      var a = abaDoAtivo(velho);
      if (a && !selecionada(a)) { var x = a.querySelector('[data-testid="close"]'); if (x) x.click(); }
    }
  }
  function escrever(campo, texto){
    var gravar = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
    campo.focus();
    gravar.call(campo, texto);
    campo.dispatchEvent(new Event("input", { bubbles: true }));
  }
  var MAX_TENTATIVAS = 4;
  function abasAgora(){
    return Array.prototype.slice.call(document.querySelectorAll('[data-testid^="AssetTab-"]'))
      .map(function(a){ return a.getAttribute("data-testid"); });
  }
  function fecharAba(testid){
    var a = document.querySelector('[data-testid="' + testid + '"]');
    if (!a) return;
    var x = a.querySelector('[data-testid="close"]');
    if (x) x.click();
  }
  function abrirPelaBusca(id, ticker){
    var deAntes = abasAgora();
    var termos = termosDeBusca(ticker), iTermo = 0;
    var querOtc = /OTC$/.test(limpo(ticker));
    var tentativa = 0;
    var desistir = function(){ fecharLista(); esconderLista(false); ocupadoTrocando = false; };
    var rodada = function(){
      if (tentativa >= MAX_TENTATIVAS) return desistir();
      var mais = document.querySelector('[data-testid="add"]');
      if (!mais) return desistir();
      mais.click();
      setTimeout(function(){
        // o aplicativo lembra o último filtro: se ficou em Binárias, a busca devolve o
        // par de Binárias e o gráfico aberto é de outro mercado.
        var fTipo = document.querySelector('[data-testid="filter-' + TIPO + '"]');
        if (fTipo) fTipo.click();
        setTimeout(function(){
          var lupa = document.querySelector('[data-testid="filtersButton"]');
          if (lupa) lupa.click();
          setTimeout(function(){
            var campo = document.querySelector('[data-testid="searchInput"]');
            if (!campo) return desistir();
            escrever(campo, termos[iTermo]);
            setTimeout(function(){ escolherEnesimo(); }, 900);
          }, 420);
        }, 380);
      }, 380);
    };
    var escolherEnesimo = function(){
      var achados = Array.prototype.slice.call(
        document.querySelectorAll('img[data-testid="assetIcon-img"]'))
        .filter(function(e){ return !e.closest('[data-testid^="AssetTab-"]'); })
        .filter(function(e){
          var otc = /OTC/.test(String(e.getAttribute("alt") || "").toUpperCase());
          return otc === querOtc;
        });
      // nada com este termo: tenta o próximo, mais curto, sem gastar tentativa
      if (!achados.length) {
        if (iTermo + 1 < termos.length) {
          iTermo++;
          var c2 = document.querySelector('[data-testid="searchInput"]');
          if (c2) { escrever(c2, termos[iTermo]); return setTimeout(escolherEnesimo, 900); }
        }
        return desistir();
      }
      if (tentativa >= achados.length) return desistir();
      var alvo = achados[tentativa];
      var e = alvo;
      for (var n = 0; n < 7 && e.parentElement; n++) {
        e = e.parentElement;
        var cx = e.getBoundingClientRect();
        if (cx.width > 200 && cx.height > 30) break;
      }
      e.click();
      // as abas só reaparecem depois que a lista sai da frente
      setTimeout(function(){
        fecharLista();
        setTimeout(conferir, 600);
      }, 700);
    };
    var conferir = function(){
      var certa = abaDoAtivo(id);
      if (certa) {
        if (!selecionada(certa)) certa.click();
        ultimoAtivo = id;
        guardarMinha(id);
        esconderLista(false);
        ocupadoTrocando = false;
        return;
      }
      // não foi esse: fecha o que abrimos por engano e vai para o próximo resultado
      abasAgora().forEach(function(t){ if (deAntes.indexOf(t) < 0) fecharAba(t); });
      tentativa++;
      setTimeout(rodada, 400);
    };
    rodada();
  }
  function mostrarAtivo(id, ticker){
    if (!id || ocupadoTrocando) return;
    var ja = abaDoAtivo(id);
    if (ja) { if (!selecionada(ja)) ja.click(); ultimoAtivo = id; return; }
    if (ultimaTentativa[id] && Date.now() - ultimaTentativa[id] < 45000) return;
    ultimaTentativa[id] = Date.now();
    ocupadoTrocando = true;
    abrirPelaBusca(id, ticker);
    // rede de segurança: se algo travar no meio, ninguém fica preso na lista
    setTimeout(function(){ if (ocupadoTrocando) { fecharLista(); esconderLista(false); ocupadoTrocando = false; } }, 12000);
  }
  // Segue a operação aberta e, entre uma e outra, deixa o gráfico no último ativo
  // operado — é onde o cliente quer continuar olhando.
  function seguirOperacao(e){
    var ops = e.operacoes || [];
    var viva = null;
    for (var i = 0; i < ops.length; i++) { if (ops[i].estado === "aberta") { viva = ops[i]; break; } }
    var alvo = viva || ops[0];
    if (!alvo || !alvo.ativo) return;
    mostrarAtivo(alvo.ativo, alvo.ticker);
  }
  var campoEmEdicao = null, valorDigitado = "";
  var TECLAS = ["1","2","3","OK","4","5","6","7","8","9","<",".","0"];
  (function montarTeclado(){
    var alvo = $("tecTeclas");
    TECLAS.forEach(function(t){
      var b = document.createElement("div");
      b.className = "tecla" + (t === "OK" ? " ok" : (t === "<" ? " apagar" : (t === "0" ? " zero" : "")));
      b.textContent = t === "<" ? "\u232b" : t;
      b.setAttribute("data-t", t);
      alvo.appendChild(b);
    });
  })();
  function abrirTeclado(id){
    campoEmEdicao = id;
    valorDigitado = "";
    $("tecRot").textContent = id === "valor" ? "VALOR"
      : (metaEmDinheiro ? "META " + simbolo() : "META %");
    $("tecVal").textContent = $(id).value || "0";
    $("teclado").classList.add("on");
  }
  function fecharTeclado(salvar){
    if (salvar && campoEmEdicao && valorDigitado !== "") {
      var v = valorDigitado.replace(/[^0-9.]/g, "");
      if (v && Number(v) > 0) $(campoEmEdicao).value = v;
    }
    campoEmEdicao = null; valorDigitado = "";
    $("teclado").classList.remove("on");
  }
  $("tecTeclas").addEventListener("click", function(ev){
    var t = ev.target && ev.target.getAttribute("data-t");
    if (!t) return;
    if (t === "OK") return fecharTeclado(true);
    if (t === "<") { valorDigitado = valorDigitado.slice(0, -1); }
    else if (t === ".") { if (valorDigitado.indexOf(".") < 0) valorDigitado = (valorDigitado || "0") + "."; }
    else { if (valorDigitado.replace(".", "").length < 7) valorDigitado += t; }
    $("tecVal").textContent = valorDigitado === "" ? "0" : valorDigitado;
  });
  ["valor","meta"].forEach(function(id){
    var c = $(id);
    if (!c) return;
    // o toque abre o NOSSO teclado; o do sistema não entra em cena
    c.addEventListener("click", function(){ abrirTeclado(id); });
    c.addEventListener("focus", function(){ this.blur(); abrirTeclado(id); });
  });
  ["cDemo","cReal"].forEach(function(id){
    $(id).addEventListener("click", function(ev){
      ev.stopPropagation();
      if (this.disabled) return;
      conta = this.getAttribute("data-conta");
      $("cDemo").classList.toggle("on", conta === "demo");
      $("cReal").classList.toggle("on", conta === "real");
    });
  });
  $("btParar").addEventListener("click", function(){
    var b = this;
    if (b.disabled) return;
    b.disabled = true;
    pedir("/api/fx/desligar", {}).then(function(j){
      if (!j || !j.ok) return avisar(traduzErro(j) || "Não consegui desligar o robô.");
      desenhar(j.estado); marcar(j.estado);
    }).catch(function(){ avisar("Sem conexão."); })
      .then(function(){ b.disabled = false; });
  });
  function simbolo(){ return (ultimo && ultimo.moeda === "USD") ? "$" : "R$"; }
  function pintarUnidade(){
    $("uniPct").classList.toggle("on", !metaEmDinheiro);
    $("uniVal").classList.toggle("on", metaEmDinheiro);
    $("uniVal").textContent = simbolo();
    $("meta").value = metaEmDinheiro ? metaGuardada.val : metaGuardada.pct;
  }
  function trocarUnidade(paraDinheiro){
    if (metaEmDinheiro === paraDinheiro) return;
    // guarda o que estava digitado antes de trocar
    if (metaEmDinheiro) metaGuardada.val = $("meta").value; else metaGuardada.pct = $("meta").value;
    metaEmDinheiro = paraDinheiro;
    // primeira vez em dinheiro: sugere o equivalente ao que estava em %
    if (paraDinheiro && !metaGuardada.val && ultimo) {
      var saldo = conta === "real" ? ultimo.saldo_real : ultimo.saldo_demo;
      var p = Number(String(metaGuardada.pct).replace(",", "."));
      if (saldo > 0 && p > 0) metaGuardada.val = String(Math.round(saldo * p / 100 * 100) / 100);
    }
    pintarUnidade();
  }
  $("uniPct").addEventListener("click", function(ev){ ev.stopPropagation(); trocarUnidade(false); });
  $("uniVal").addEventListener("click", function(ev){ ev.stopPropagation(); trocarUnidade(true); });
  $("btLigar").addEventListener("click", function(){
    var valor = Number(String($("valor").value).replace(",", "."));
    var meta = Number(String($("meta").value).replace(",", "."));
    if (!(valor > 0)) return avisar("Informe o valor por operação.");
    if (!(meta > 0)) return avisar("Informe a meta de lucro.");
    if (metaEmDinheiro) metaGuardada.val = $("meta").value; else metaGuardada.pct = $("meta").value;
    var saldo = conta === "real" ? (ultimo && ultimo.saldo_real) : (ultimo && ultimo.saldo_demo);
    if (ultimo && !(Number(saldo) > 0)) {
      return avisar(conta === "real" ? "Seu saldo na conta real está zerado. Faça um depósito para começar."
                                     : "Seu saldo na conta demo está zerado.");
    }
    var b = this; b.disabled = true;
    var alvo = metaEmDinheiro ? { meta_valor: meta } : { meta_pct: meta };
    pedir("/api/fx/ligar", Object.assign({ valor: valor, conta: conta }, alvo)).then(function(j){
      if (!j || !j.ok) return avisar(traduzErro(j) || "Não consegui ligar o robô.");
      desenhar(j.estado); marcar(j.estado);
      // o saldo do topo passa a ser o da conta em que o robô vai operar
      try { acertarContaDoTopo(conta); } catch (e) {}
    }).catch(function(){}).then(function(){ b.disabled = false; });
  });
  var ICONE_HIST = $("btHist").innerHTML;
  var ICONE_VOLTA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" ' +
    'stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 7-7"/><path d="M14 8h6v6"/></svg>';
  function noHistorico(){ return /\/trades/.test(location.pathname); }
  function irPara(qual){
    // pelo menu do próprio aplicativo: ele troca de tela sem recarregar. Recarregar
    // levaria o computador para /traderoom, que é outra sala, sem o robô.
    var item = document.querySelector('[data-testid="NavigationMenuItem-' + qual + '"]');
    if (item) { item.click(); return true; }
    var link = document.querySelector('a[href$="/pwa/' + qual + '"]');
    if (link) { link.click(); return true; }
    return false;
  }
  $("btHist").addEventListener("click", function(){
    // NUNCA recarregar a página: no computador o servidor mandaria /pwa/* para
    // /traderoom, que é outra sala — o cliente perderia o robô da tela. Se o menu não
    // estiver acessível agora (a lista de ativos está aberta durante uma troca),
    // fechamos a lista e tentamos de novo em seguida.
    var destino = noHistorico() ? "traderoom" : "trades";
    if (irPara(destino)) return;
    fecharLista(); esconderLista(false);
    var tentativas = 0;
    var denovo = function(){
      if (irPara(destino)) return;
      if (++tentativas < 8) setTimeout(denovo, 400);
    };
    setTimeout(denovo, 400);
  });
  setInterval(function(){
    var b = $("btHist");
    var volta = noHistorico();
    if (b.dataset.modo !== (volta ? "volta" : "hist")) {
      b.dataset.modo = volta ? "volta" : "hist";
      b.innerHTML = volta ? ICONE_VOLTA : ICONE_HIST;
      b.title = volta ? "Back to chart" : "Trade history";
    }
    // ao voltar do histórico o aplicativo repõe /pwa/traderoom; devolvemos o endereço
    // desta tela, senão um recarregar levaria o cliente para a sala sem o robô.
    if (window.__fxRotaBonita && location.pathname === "/pwa/traderoom") {
      try { history.replaceState(history.state, "", window.__fxRotaBonita + location.search + location.hash); }
      catch (e) {}
    }
  }, 600);
})();
</script></body></html>