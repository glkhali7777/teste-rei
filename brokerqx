    <script>
      // ВАЖНО: логика разрешения темы должна совпадать с getInitialTheme/resolveSystemTheme
      // в src/core/app/providers/ThemeContext.tsx. Любое изменение дефолта/правил резолва
      // нужно синхронно править в обоих местах, иначе на первом рендере будет мигание (FOUC).
      (function () {
        var storedTheme = localStorage.getItem('theme-preference');
        if (storedTheme === 'light') {
          document.documentElement.setAttribute('theme', 'light');
        } else if (storedTheme === 'system') {
          if (!window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('theme', 'light');
          }
        }
        // 'dark' и отсутствие значения → ничего не делаем (dark = дефолт без атрибута)
      })();
    </script>

